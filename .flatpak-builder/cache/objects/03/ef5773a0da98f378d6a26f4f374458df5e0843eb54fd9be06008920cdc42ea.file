{
  "id" : "com.bhh32.CateringInvoice",
  "runtime" : "org.freedesktop.Platform",
  "runtime-version" : "24.08",
  "runtime-commit" : "a993292d6ff150598dad4cd1f725aeee01a668b9e721b559ea1b6f6240174d58",
  "sdk" : "org.freedesktop.Sdk",
  "sdk-commit" : "880e38dedfd737008ddd0ebbbd0daaaed26b0d20011b0ce622d411a36446d607",
  "build-options" : {
    "env" : {
      "CARGO_HOME" : "/run/build/catering_invoice/cargo"
    },
    "build-args" : [
      "--share=network"
    ],
    "append-path" : "/usr/lib/sdk/rust-stable/bin"
  },
  "command" : "catering_invoice",
  "modules" : [
    {
      "name" : "catering_invoice",
      "buildsystem" : "simple",
      "sources" : [
        {
          "url" : "https://github.com/bhh32/catering_invoice.git",
          "commit" : "07e59cd34c2e403498873da3562f6cc3d38f4736",
          "type" : "git"
        }
      ],
      "build-commands" : [
        "cargo build --release --verbose",
        "install -Dm755 ./target/release/catering_invoice -t /app/bin/",
        "install -Dm644 ./res/com.bhh32.CateringInvoice.desktop -t /app/share/applications/",
        "install -Dm644 ./res/icons/hicolor/scalable/apps/com.bhh32.CateringInvoice.svg -t /app/share/icons/hicolor/scalable/apps/ || true",
        "update-desktop-database -q /app/share/applications/ || true"
      ]
    }
  ],
  "sdk-extensions" : [
    "org.freedesktop.Sdk.Extension.rust-stable"
  ],
  "finish-args" : [
    "--socket=wayland",
    "--socket=fallback-x11",
    "--device=dri",
    "--filesystem=home",
    "--filesystem=xdg-documents",
    "--socket=session-bus",
    "--talk-name=org.freedesktop.portal.Desktop",
    "--talk-name=org.freedesktop.portal.FileChooser",
    "--share=ipc",
    "--share=network"
  ],
  "source-date-epoch" : 1763232953
}